<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <!-- Schedule.cs is pure (no WinForms), so link it instead of referencing the self-contained exe project. -->
  <ItemGroup>
    <Compile Include="..\..\src\Schedule.cs" Link="Schedule.cs" />
    <Compile Include="..\..\src\History.cs" Link="History.cs" />
  </ItemGroup>

</Project>
